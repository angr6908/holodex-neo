{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "routes": [
    {
      "src": "^/(watch|search|edit/video)(/.*)?$",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "Applebot" } }],
      "mitigate": { "action": "deny" }
    },
    {
      "src": "^/(?!robots\\.txt$).*$",
      "has": [{ "type": "header", "key": "user-agent", "value": { "re": "Reflectionbot" } }],
      "mitigate": { "action": "deny" }
    }
  ]
}
